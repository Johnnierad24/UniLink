DJANGO_SECRET_KEY=change-me-32bytes-random
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_TIME_ZONE=Africa/Nairobi

# Database (prefer POSTGRES_URL; otherwise fill individual fields)
POSTGRES_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=DBNAME
DJANGO_DB_USER=USER
DJANGO_DB_PASSWORD=PASSWORD
DJANGO_DB_HOST=HOST
DJANGO_DB_PORT=5432

# CORS
DJANGO_CORS_ALLOW_ALL=false
DJANGO_CORS_ALLOWED_ORIGINS=https://your-frontend.example

# Security
DJANGO_SECURE_COOKIES=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_REQUIRE_EMAIL_VERIFIED=true

# Pagination & throttles
DJANGO_PAGE_SIZE=20
DRF_THROTTLE_ANON=60/min
DRF_THROTTLE_USER=120/min

# Email (for verification)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.yourprovider.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=you@example.com
DJANGO_EMAIL_PASSWORD=yourpassword
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=no-reply@yourdomain.com
DJANGO_EMAIL_VERIFY_URL=https://your-frontend.example/verify-email

# SMS (for class postponement notifications)
# SMS_PROVIDER=africastalking  # or 'twilio'
# SMS_API_KEY=your-africas-talking-api-key
# SMS_SENDER_ID=UniLink
# SMS_RECIPIENTS=+254700000000,+254711111111  # List of phone numbers for testing
